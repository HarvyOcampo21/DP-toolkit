{
  "manifest_version": 3,
  "name": "DP Toolkit",
  "version": "80",
  "description": "Assign & track photo requests, copy/log listing info to Google Sheets, and preview/download listing photos — all in one extension. Access level (senior/junior) is detected automatically from the name you select.",
  "key": "",
  "permissions": ["storage", "clipboardWrite", "downloads", "offscreen", "tabs", "notifications", "alarms", "sidePanel"],
  "host_permissions": [
    "https://newcrm.drivenproperties.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://drive.google.com/*",
    "https://cdn.crm.drivenproperties.com/*"
  ],
  "externally_connectable": {
    "matches": ["https://dp-dashboard-5j9.pages.dev/*"]
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "DP Toolkit" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://newcrm.drivenproperties.com/photorequest/*"],
      "js": ["identity-guard.js", "assigner-content.js", "copier-content.js", "auto-all-click-content.js"],
      "css": ["assigner-styles.css", "copier-styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://newcrm.drivenproperties.com/*"],
      "js": ["identity-guard.js", "select.js"],
      "run_at": "document_idle"
    }
  ]
}
